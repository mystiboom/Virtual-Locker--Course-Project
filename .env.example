# MongoDB Connection String
# For production, use a secure MongoDB Atlas connection string or self-hosted instance with authentication
MONGO_URI=mongodb://127.0.0.1:27017/fileUploads

# Encrypted Folder Password Hash
# In production, set this to a strong password hash generated by bcrypt
# Example: to generate, use: bcrypt.hash("yourStrongPasswordHere", 10)
# Never use the default password in production!
ENCRYPTED_FOLDER_PASSWORD_HASH=your_bcrypt_hash_here

# Optional: Port Configuration
# PORT=3000